{
  "name": "gaarf-web",
  "version": "4.3.0",
  "description": "Google Ads API Report Fetcher (Gaarf) for Web / Browser",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/web/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/web/src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema/v25": {
      "types": "./dist/web/src/lib/bundled-schema.d.ts",
      "import": "./dist/schema/v25.js",
      "default": "./dist/schema/v25.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/google/ads-api-report-fetcher"
  },
  "homepage": "https://github.com/google/ads-api-report-fetcher/js/web",
  "publishConfig": {
    "registry": "https://wombat-dressing-room.appspot.com"
  },
  "author": "Sergei Dorogin",
  "license": "Apache-2.0",
  "scripts": {
    "clean": "rimraf dist",
    "bundle": "rollup -c rollup.config.mjs",
    "build": "npm run clean && npm run bundle",
    "prepublishOnly": "npm run test && npm run build",
    "test": "mocha --ui tdd --loader=ts-node/esm --require ts-node/register --timeout 10s src/test/**/*.ts"
  },
  "dependencies": {
    "@js-joda/core": "^5.7.0",
    "async": "^3.2.6",
    "axios": "^1.13.6",
    "date-fns": "^4.1.0",
    "lodash-es": "^4.17.23",
    "mathjs": "^15.1.1",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/mocha": "^10.0.10",
    "mocha": "^11.7.5",
    "rimraf": "^5.0.5",
    "rollup": "^4.24.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
